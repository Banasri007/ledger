# Tier 3 (the reasoning tier) calls the Anthropic API through /api/reconcile.
# Copy this file to .env.local and paste your key. .env.local is gitignored.
#
#   cp .env.example .env.local
#
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5.
# LEDGER_MODEL=claude-opus-5
